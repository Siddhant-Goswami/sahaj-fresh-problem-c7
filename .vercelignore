# Vercel's CLI does NOT read .gitignore when uploading, so the facilitator
# plaintext has to be excluded here as well. Without this line the hidden
# eval set is served as a static file and stops measuring anything.
.facilitator-src/

# Build-time only, not needed by the deployed site.
build-corpus.js
build-fac.js

.DS_Store
node_modules/
.env*

# Lecture artifacts. Built from the corpus for the facilitated session and for
# the evals-and-guardrails lecture. Never deployed: lecture/tickets.json is a
# labelled eval set and agent-bench/ carries goal states. Serving either as a
# static file turns both into sets that no longer measure anything.
lecture/
agent-bench/
